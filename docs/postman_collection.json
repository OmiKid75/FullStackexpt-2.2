{
  "info": {
    "name": "Campus Library Resource Explorer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Experiment 2.2.1 - Pagination and sorting",
      "item": [
        {
          "name": "List (defaults)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "resources"
              ]
            }
          }
        },
        {
          "name": "Page 1, size 20",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources?page=1&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "resources"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Sort by title asc",
          "request": {
            "method": "GET",
            "header": [],
