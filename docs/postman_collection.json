                "api",
                "resources"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "rating"
                },
                {
                  "key": "direction",
                  "value": "desc"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/resources?categoryId=1&page=0&size=10",
