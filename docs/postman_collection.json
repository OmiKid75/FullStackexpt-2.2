              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/resources/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "resources",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Spring Boot in Action\",\n  \"description\": \"Practical guide\",\n  \"author\": \"A. Student\",\n  \"categoryId\": 1,\n  \"resourceType\": \"BOOK\",\n  \"rating\": 4.5\n}"
            }
          }
        },
